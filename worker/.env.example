ENV=dev

# Redis — must point to the same instance used by the API
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TTL_SECONDS=86400
CACHE_KEY_PREFIX=multi-db-connector

# How long scan results are retained in Redis (default 7 days)
SCAN_RESULTS_TTL_SECONDS=604800

# How long the worker blocks waiting for new stream messages in ms (default 5s)
WORKER_STREAM_BLOCK_MS=5000

# MySQL — each host is activated only if its _HOST var is set
MYSQL_DB1_HOST=
MYSQL_DB1_USER=
MYSQL_DB1_PASSWORD=
MYSQL_DB1_PORT=3306

MYSQL_DB2_HOST=
MYSQL_DB2_USER=
MYSQL_DB2_PASSWORD=
MYSQL_DB2_PORT=3306

# PostgreSQL — activated only if POSTGRES_HOST is set
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
POSTGRES_POOL_SIZE=5

# Amazon Athena — activated only if ATHENA_REGION is set
ATHENA_REGION=
ATHENA_CATALOG=AwsDataCatalog
ATHENA_S3_OUTPUT=

# Trino — activated only if TRINO_HOST is set
TRINO_HOST=
TRINO_PORT=8080
TRINO_USER=trino
TRINO_PASSWORD=
TRINO_HTTP_SCHEME=http

# Presto — activated only if PRESTO_HOST is set
PRESTO_HOST=
PRESTO_PORT=8080
PRESTO_USER=presto
PRESTO_PASSWORD=
PRESTO_HTTP_SCHEME=http

# Amazon DynamoDB — activated only if DYNAMODB_REGION is set
DYNAMODB_REGION=
DYNAMODB_ENDPOINT_URL=

# MongoDB — activated only if MONGODB_HOST is set
MONGODB_HOST=
MONGODB_PORT=27017
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=admin
MONGODB_TLS=false
MONGODB_TLS_ALLOW_INVALID=false

# AWS credentials (shared by Athena and DynamoDB — optional with IAM role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
