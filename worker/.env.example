ENV=dev

# LiteLLM — used only when generate_ai_docs=true
LITELLM_MODEL=gpt-4o-mini
LITELLM_API_KEY=
LITELLM_API_BASE=

# Redis — must point to the same instance used by the API
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TTL_SECONDS=86400
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=2
REDIS_CACHE_SOCKET_TIMEOUT_SECONDS=2
CACHE_KEY_PREFIX=irides

# Canonical JSON metadata and derived Markdown/OKF artifacts
STORAGE_METADATA_DIR=storage/metadata
STORAGE_EXPORT_DIR=storage/exports
METADATA_STORE_TYPE=file

# How long scan results are retained in Redis (default 7 days)
SCAN_RESULTS_TTL_SECONDS=604800

# How long the worker blocks waiting for new stream messages in ms (default 5s)
WORKER_STREAM_BLOCK_MS=5000

# DB targets for Docker/local runtime.
# Each name in DB_TARGETS maps to DB_TARGET_<UPPERCASE_NAME>_* variables.
# Non-alphanumeric characters in target names become underscores.
# Do not add spaces around "=" or "," when sourcing this file in bash.
#
# Example:
# DB_TARGETS=mysql_primary,mysql_secondary
# DB_TARGET_MYSQL_PRIMARY_TYPE=mysql
# DB_TARGET_MYSQL_PRIMARY_HOST=db-primary.example.internal
# DB_TARGET_MYSQL_PRIMARY_USER=reader
# DB_TARGET_MYSQL_PRIMARY_PASSWORD=
# DB_TARGET_MYSQL_PRIMARY_PORT=3306
#
# DB_TARGET_MYSQL_SECONDARY_TYPE=mysql
# DB_TARGET_MYSQL_SECONDARY_HOST=db-secondary.example.internal
# DB_TARGET_MYSQL_SECONDARY_USER=reader
# DB_TARGET_MYSQL_SECONDARY_PASSWORD=
# DB_TARGET_MYSQL_SECONDARY_PORT=3306
DB_TARGETS=

# AWS credentials (shared by Athena and DynamoDB — optional with IAM role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
