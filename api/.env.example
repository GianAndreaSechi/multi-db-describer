ENV=dev

# Redis — must point to the same instance used by the Worker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TTL_SECONDS=86400
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=2
REDIS_CACHE_SOCKET_TIMEOUT_SECONDS=2
CACHE_KEY_PREFIX=irides

# LiteLLM — used only when generate_ai_docs=true
LITELLM_MODEL=gpt-4o-mini
LITELLM_API_KEY=
LITELLM_API_BASE=

# DB targets for Docker/local runtime.
# Each name in DB_TARGETS maps to DB_TARGET_<UPPERCASE_NAME>_* variables.
# Non-alphanumeric characters in target names become underscores.
# Do not add spaces around "=" or "," when sourcing this file in bash.
#
# Example:
# DB_TARGETS=mysql_instance_1_dev,mysql_instance_2_dev
# DB_TARGET_MYSQL_INSTANCE_1_DEV_TYPE=mysql
# DB_TARGET_MYSQL_INSTANCE_1_DEV_HOST=db-primary.example.internal
# DB_TARGET_MYSQL_INSTANCE_1_DEV_USER=reader
# DB_TARGET_MYSQL_INSTANCE_1_DEV_PASSWORD=
# DB_TARGET_MYSQL_INSTANCE_1_DEV_PORT=3306
#
# DB_TARGET_MYSQL_INSTANCE_2_DEV_TYPE=mysql
# DB_TARGET_MYSQL_INSTANCE_2_DEV_HOST=db-secondary.example.internal
# DB_TARGET_MYSQL_INSTANCE_2_DEV_USER=reader
# DB_TARGET_MYSQL_INSTANCE_2_DEV_PASSWORD=
# DB_TARGET_MYSQL_INSTANCE_2_DEV_PORT=3306
DB_TARGETS=

# AWS credentials (shared by Athena and DynamoDB — optional with IAM role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
