ENV=dev

# Redis cache — optional for the CLI, but must match the shared Iride instance
# when caching is enabled.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TTL_SECONDS=86400
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=2
REDIS_CACHE_SOCKET_TIMEOUT_SECONDS=2
CACHE_KEY_PREFIX=irides

# Location for JSON metadata written by `irides describe`.
STORAGE_METADATA_DIR=storage/metadata
# Location for Markdown and OKF artifacts generated by default.
STORAGE_EXPORT_DIR=storage/exports
METADATA_STORE_TYPE=file

# LiteLLM — used only with `irides describe --generate-ai-docs`.
LITELLM_MODEL=gpt-4o-mini
LITELLM_API_KEY=
LITELLM_API_BASE=
LITELLM_TIMEOUT_SECONDS=120
LITELLM_MAX_RETRIES=2

# Database targets.
# Each name in DB_TARGETS maps to DB_TARGET_<UPPERCASE_NAME>_* variables.
# Non-alphanumeric characters in target names become underscores.
# Do not add spaces around "=" or "," when sourcing this file in bash.
#
# Example MySQL target:
# DB_TARGETS=sales_mysql
# DB_TARGET_SALES_MYSQL_TYPE=mysql
# DB_TARGET_SALES_MYSQL_HOST=mysql.internal
# DB_TARGET_SALES_MYSQL_USER=reader
# DB_TARGET_SALES_MYSQL_PASSWORD=
# DB_TARGET_SALES_MYSQL_PORT=3306
#
# Example PostgreSQL target:
# DB_TARGETS=analytics_pg
# DB_TARGET_ANALYTICS_PG_TYPE=postgres
# DB_TARGET_ANALYTICS_PG_HOST=postgres.internal
# DB_TARGET_ANALYTICS_PG_PORT=5432
# DB_TARGET_ANALYTICS_PG_USER=reader
# DB_TARGET_ANALYTICS_PG_PASSWORD=
# DB_TARGET_ANALYTICS_PG_DATABASE=analytics
DB_TARGETS=

# AWS credentials — shared by Athena and DynamoDB (optional with an IAM role).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
